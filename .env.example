# Django
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Database
# Examples:
# DATABASE_URL=sqlite:///D:/heathcare ai/var/db.sqlite3
# DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/curamind
# Recommended: do not set `DATABASE_URL` for SQLite dev; the project defaults to `./var/db.sqlite3`.

# Celery (Redis recommended)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Security toggles for production (set True behind HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
